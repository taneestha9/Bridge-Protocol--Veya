generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  city              String
  country           String
  type              String
  description       String?
  website           String?
  logoUrl           String?
  latitude          Float?
  longitude         Float?
  configuration     Json?
  status            OrganizationStatus   @default(pending)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  activities        ActivityLog[]
  beneficiaries     Beneficiary[]
  cases             Case[]
  donors            Donor[]
  members           OrganizationMember[]
  volunteers        Volunteer[]
  chapters          Chapter[]
  resourceProviders ResourceProvider[]
  supportRequests   SupportRequest[]
  consentRecords    ConsentRecord[]

  @@index([country, city])
  @@index([status])
  @@map("organizations")
}

model User {
  id                 String               @id @default(cuid())
  authUserId         String               @unique
  email              String               @unique
  fullName           String
  avatarUrl          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  activities         ActivityLog[]
  memberships        OrganizationMember[]
  chapterMemberships ChapterMembership[]
  providerProfiles   ResourceProvider[]
  supportRequests    SupportRequest[]
  consentRecords     ConsentRecord[]

  @@map("users")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(viewer)
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model Beneficiary {
  id                 String             @id @default(cuid())
  organizationId     String
  residentId         String
  name               String
  phone              String?
  location           String
  lat                Float?
  lng                Float?
  notes              String?
  verificationStatus VerificationStatus @default(pending)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases              Case[]

  @@unique([organizationId, residentId])
  @@index([organizationId, verificationStatus])
  @@map("beneficiaries")
}

model Case {
  id                 String         @id @default(cuid())
  organizationId     String
  beneficiaryId      String
  title              String
  description        String
  category           String
  urgency            Urgency        @default(green)
  status             CaseStatus     @default(submitted)
  verificationLevel  Int            @default(0)
  matchedVolunteerId String?
  donorId            String?
  estimatedValue     Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?
  auditLogs          CaseAuditLog[]
  beneficiary        Beneficiary    @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  donor              Donor?         @relation(fields: [donorId], references: [id])
  volunteer          Volunteer?     @relation(fields: [matchedVolunteerId], references: [id])
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matches            Match[]
  chapterId          String?
  chapter            Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, category])
  @@map("cases")
}

model CaseAuditLog {
  id            String   @id @default(cuid())
  caseId        String
  actorId       String
  action        String
  previousState String?
  newState      String
  metadata      Json?
  createdAt     DateTime @default(now())
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("case_audit_logs")
}

model Volunteer {
  id               String          @id @default(cuid())
  organizationId   String
  name             String
  email            String?
  phone            String?
  location         String
  lat              Float?
  lng              Float?
  skills           String[]
  availability     String?
  reliabilityScore Float           @default(0)
  status           VolunteerStatus @default(active)
  deliveryCount    Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assignedCases    Case[]
  matches          Match[]
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("volunteers")
}

model Donor {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  email            String?
  phone            String?
  type             DonorType    @default(individual)
  totalContributed Float        @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  cases            Case[]
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Match            Match[]

  @@index([organizationId])
  @@map("donors")
}

model Match {
  id          String      @id @default(cuid())
  caseId      String
  volunteerId String?
  donorId     String?
  matchScore  Float?
  status      MatchStatus @default(recommended)
  approvedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  donor       Donor?      @relation(fields: [donorId], references: [id])
  volunteer   Volunteer?  @relation(fields: [volunteerId], references: [id])

  @@index([caseId, status])
  @@index([volunteerId])
  @@map("matches")
}

model ActivityLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorType      String
  actorId        String
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("activity_logs")
}

model Chapter {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String        @unique
  city           String
  country        String
  serviceArea    String?
  description    String?       @db.Text
  latitude       Float?
  longitude      Float?
  status         ChapterStatus @default(pending)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships   ChapterMembership[]
  cases         Case[]
  opportunities Opportunity[]

  @@index([organizationId, status])
  @@index([country, city])
  @@map("chapters")
}

model ChapterMembership {
  id        String     @id @default(cuid())
  userId    String
  chapterId String
  role      MemberRole @default(volunteer)
  status    String     @default("active")
  joinedAt  DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId, role])
  @@map("chapter_memberships")
}

model Opportunity {
  id          String            @id @default(cuid())
  chapterId   String
  title       String
  description String            @db.Text
  category    String
  status      OpportunityStatus @default(draft)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, status])
  @@map("opportunities")
}

model ResourceProvider {
  id                 String             @id @default(cuid())
  userId             String?
  organizationId     String?
  name               String
  type               String
  description        String?            @db.Text
  serviceArea        String?
  verificationStatus VerificationStatus @default(pending)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  @@map("resource_providers")
}

model SupportRequest {
  id              String   @id @default(cuid())
  requesterUserId String?
  organizationId  String?
  category        String
  description     String   @db.Text
  location        String?
  urgency         Urgency  @default(green)
  status          String   @default("submitted")
  consentGiven    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requester    User?         @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, urgency])
  @@index([organizationId])
  @@map("support_requests")
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String?
  subjectRef String
  purpose    String
  granted    Boolean
  version    String
  createdAt  DateTime @default(now())

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([subjectRef])
  @@map("consent_records")
}

enum OrganizationStatus {
  pending
  active
  suspended
}

enum MemberRole {
  platform_admin
  chapter_admin
  coordinator
  volunteer
  viewer
}

enum VerificationStatus {
  pending
  reviewed
  verified
  flagged
}

enum CaseStatus {
  submitted
  under_review
  verified
  open
  matched
  in_progress
  fulfilled
  closed
  rejected
  cancelled
  suspended
}

enum Urgency {
  green
  yellow
  red
}

enum VolunteerStatus {
  active
  inactive
  suspended
}

enum MatchStatus {
  recommended
  approved
  rejected
  completed
}

enum DonorType {
  individual
  corporate
  institutional
}

enum ParticipationRole {
  explorer
  volunteer
  organization_admin
  chapter_coordinator
  case_worker
  resource_provider
  support_seeker
  institution
  network_admin
}

enum ChapterStatus {
  pending
  active
  suspended
  archived
}

enum OpportunityStatus {
  draft
  open
  filled
  closed
  cancelled
}
